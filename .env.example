# ─── Database ────────────────────────────────────────────────────────────────
# Leave empty to use the embedded PostgreSQL (PGlite) stored in ./.data — zero
# setup, development only. For production point this at Postgres/Supabase
# (pgvector extension required).
# DATABASE_URL=postgres://user:pass@host:5432/dumonda
DATABASE_URL=

# ─── AI provider ─────────────────────────────────────────────────────────────
# "apertus"       → Swiss Apertus model via an OpenAI-compatible endpoint
# "openai-compat" → any OpenAI-compatible endpoint (dev fallback LLM)
# "deterministic" → no LLM at all: keyword classifier + rules engine + verified
#                   sources only. Never fabricates. Default for local dev.
AI_PROVIDER=deterministic

APERTUS_BASE_URL=
APERTUS_API_KEY=
APERTUS_MODEL=swiss-ai/apertus-70b-instruct

# Used when AI_PROVIDER=openai-compat
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# ─── Embeddings ──────────────────────────────────────────────────────────────
# "hash" is a deterministic local embedder for development (clearly not
# semantic). Set to "openai-compat" with the endpoint below for real embeddings.
EMBEDDINGS_PROVIDER=hash
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for POST /api/cron/refetch and /api/cron/reminders
# (Authorization: Bearer <secret>). Leave empty to disable the endpoints.
CRON_SECRET=

# ─── Email (reminders) ───────────────────────────────────────────────────────
# "console" logs mails to the server output (dev; nothing is delivered).
# "resend-compat" posts to a Resend-compatible HTTP API.
EMAIL_PROVIDER=console
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=Dumonda <reminders@dumonda.ch>

# ─── Auth ────────────────────────────────────────────────────────────────────
# Seeded admin account for /admin (change in production!)
ADMIN_EMAIL=admin@dumonda.local
ADMIN_PASSWORD=dumonda-admin-dev
